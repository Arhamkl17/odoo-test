{
  "name": "Odoo 19 POS Dev",

  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.override.yml"
  ],

  "service": "odoo",

  "workspaceFolder": "/workspaces/Odoo-mv",

  "forwardPorts": [8069, 5432],

  "portsAttributes": {
    "8069": {
      "label": "Odoo",
      "onAutoForward": "openBrowser"
    }
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  },

  "remoteUser": "root"
}
