<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!--
        Di-inherit dari template point_of_sale.Orderline, dipakai bareng oleh
        ProductScreen (cart) dan OrderReceipt (struk).

        xpath 1: badge label pedas (dinonaktifkan sementara, t-if false) +
                 qty stepper/tombol hapus — ditaruh DI DALAM line-details,
                 sejajar baris nama produk (bukan baris terpisah di bawah).
        xpath 2: sembunyikan product-price bawaan (posisinya semula sejajar
                 nama, sekarang digantikan stepper).
        xpath 3: baris harga baru di bawah line-details, bold merah, sesuai
                 referensi desain.
    -->
    <t t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-name')]" position="after">
            <div t-if="false and props.line.spice_level" class="spice-level-badge small fw-bold text-danger">
                <i class="fa fa-fire me-1" role="img" aria-label="Level Pedas"/>
                <t t-esc="spiceLevelLabel"/>
            </div>
            <div t-if="props.mode !== 'receipt'" class="gy-line-controls d-flex align-items-center flex-shrink-0 ms-2">
                <QuantityButtons
                    quantity="line.qty"
                    setQuantity="(qty) => this.gySetLineQuantity(line, qty)"
                    btnClasses="'gy-qty-btn'"
                />
                <button class="gy-delete-line-btn btn btn-sm"
                        t-on-click.stop="() => this.gyDeleteLine(line)">
                    <i class="fa fa-trash" role="img" aria-label="Hapus"/>
                </button>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('product-price')]" position="replace"/>
        <xpath expr="//div[hasclass('line-details')]" position="after">
            <div t-if="vals.price and props.mode !== 'receipt'" class="gy-line-price fw-bolder text-danger" t-out="vals.price"/>
        </xpath>
    </t>
</templates>
