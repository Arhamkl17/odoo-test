<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_geprekyukss_dashboard" model="ir.actions.client">
            <field name="name">Dashboard Keuangan</field>
            <field name="tag">geprekyukss_dashboard.main</field>
        </record>

        <menuitem id="menu_geprekyukss_dashboard_root"
                  name="Dashboard Keuangan"
                  action="action_geprekyukss_dashboard"
                  web_icon="geprekyukss_dashboard,static/description/icon.png"
                  sequence="15"/>

        <!-- F1 Report Shell — client action halaman Laporan (AFR + MIS Builder).
             TANPA menuitem: root menu harus tetap langsung membuka dashboard;
             entry point = sidebar "Laporan" di dalam dashboard (keputusan Q2)
             yang memanggil doAction("geprekyukss_dashboard.action_geprekyukss_reports"). -->
        <record id="action_geprekyukss_reports" model="ir.actions.client">
            <field name="name">Laporan Keuangan</field>
            <field name="tag">geprekyukss_dashboard.reports</field>
        </record>
    </data>
</odoo>
