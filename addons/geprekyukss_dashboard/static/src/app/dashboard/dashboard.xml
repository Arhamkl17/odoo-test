                            <tr><td t-esc="o.name"/><td class="right" t-esc="formatRp(o.amount_total)"/><td class="right" t-esc="o.order_count"/><td class="right" t-esc="formatRp(o.avg_ticket)"/></tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <div class="gk-grid-2">
                <div class="gk-card">
                    <div class="gk-card-head"><h3>Arus Kas Periode Ini</h3></div>
                    <div class="gk-cashflow">
                        <div class="gk-cashflow-item in"><i class="fa fa-arrow-down"/><div><div class="gk-muted">Uang Masuk</div><b t-esc="formatRp(state.data.finance.cashflow.in)"/></div></div>
                        <div class="gk-cashflow-item out"><i class="fa fa-arrow-up"/><div><div class="gk-muted">Uang Keluar</div><b t-esc="formatRp(state.data.finance.cashflow.out)"/></div></div>
                        <div class="gk-cashflow-item"><i class="fa fa-exchange"/><div><div class="gk-muted">Net</div><b t-esc="formatRp(state.data.finance.cashflow.net)"/></div></div>
                    </div>
                </div>
                <div class="gk-card">
                    <div class="gk-card-head"><h3>Piutang Corporate Belum Lunas</h3></div>
                    <t t-if="state.data.finance.receivables.list.length">
                        <table class="gk-table">
                            <thead><tr><th>Faktur</th><th>Partner</th><th>Jatuh Tempo</th><th class="right">Nominal</th></tr></thead>
                            <tbody>
                                <t t-foreach="state.data.finance.receivables.list" t-as="r" t-key="r.name">
                                    <tr><td t-esc="r.name"/><td t-esc="r.partner"/><td t-esc="r.due"/><td class="right" t-esc="formatRp(r.residual)"/></tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                    <t t-else=""><p class="gk-muted">Tidak ada piutang open. ✔</p></t>
                </div>
            </div>
        </t>

        <!-- ============ PENJUALAN (penjualan.png — F0: existing Tab 3; F3 tambah Produk Terlaris + Daftar Transaksi 15/hal) ============ -->
        <t t-elif="state.activeTab === 'penjualan'">
            <div class="gk-kpi-row" style="grid-template-columns: repeat(4, 1fr);">
                <div class="gk-card gk-kpi">
                    <div class="gk-kpi-label">Total Penjualan</div>
                    <div class="gk-kpi-value" t-esc="formatRp(state.data.sales.amount_total, true)"/>
                    <div class="gk-kpi-foot"><span class="gk-muted" t-esc="state.data.sales.order_count.toLocaleString('id-ID') + ' transaksi'"/></div>
                </div>
                <div class="gk-card gk-kpi">
                    <div class="gk-kpi-label">Jumlah Transaksi</div>
                    <div class="gk-kpi-value" t-esc="state.data.sales.order_count.toLocaleString('id-ID')"/>
                    <div class="gk-kpi-foot"><span t-att-class="'gk-badge ' + pctClass(state.data.summary.vs.order_count)" t-esc="pctArrow(state.data.summary.vs.order_count) or '—'"/> <span class="gk-muted">vs periode sebelumnya</span></div>
                </div>
                <div class="gk-card gk-kpi">
                    <div class="gk-kpi-label">Rata-rata Transaksi</div>
                    <div class="gk-kpi-value" t-esc="formatRp(state.data.sales.avg_daily_orders * (state.data.sales.amount_total / Math.max(state.data.sales.order_count,1)) || 0)"/>
                    <div class="gk-kpi-foot"><span class="gk-muted">per hari</span></div>
                </div>
                <div class="gk-card gk-kpi">
                    <div class="gk-kpi-label">Produk Terjual</div>
                    <div class="gk-kpi-value" t-esc="state.data.sales.top_by_qty.reduce((s,x) =&gt; s + x.qty, 0).toLocaleString('id-ID') + ' item'"/>
                    <div class="gk-kpi-foot"><span class="gk-muted">total qty</span></div>
                </div>
            </div>

            <div class="gk-grid-2">
                <div class="gk-card">
                    <div class="gk-card-head"><h3>Komposisi Channel</h3></div>
                    <div class="gk-channel-wrap">
                        <div class="gk-chart-channel gk-chart-box square"><canvas/></div>
                        <div class="gk-channel-legend">
                            <t t-foreach="state.data.sales.channels" t-as="c" t-key="c.name">
                                <div class="gk-channel-row">
                                    <span class="gk-legend-color" t-att-style="'background:' + (gkChannelColor(c.name) || '#64748B')"/>
                                    <span class="gk-channel-name" t-esc="c.name"/>
                                    <span class="gk-muted" t-esc="c.order_count + ' order'"/>
                                    <b t-esc="formatRp(c.amount, true)"/>
                                    <span class="gk-badge up" t-esc="c.pct + '%'"/>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
                <div class="gk-card">
                    <div class="gk-card-head"><h3>Metode Pembayaran</h3></div>
                    <div class="gk-expense-list">
                        <t t-foreach="state.data.sales.payments" t-as="p" t-key="p.name">
                            <div class="gk-expense-row">
                                <div class="gk-expense-label">
                                    <span><t t-esc="p.name"/> <span class="gk-muted">· <t t-esc="p.order_count"/>x</span></span>
                                    <span class="gk-expense-right"><b t-esc="formatRp(p.amount)"/><span class="gk-pct" t-esc="pctLabel(p.amount, paymentsTotal())"/></span>
                                </div>
                                <div class="gk-bar-track">
                                    <div class="gk-bar-fill" t-att-style="'width:' + barPct(p.amount, state.data.sales.payments[0].amount) + ';background:' + gkPaymentColor(p.group)"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <div class="gk-card">
                <div class="gk-card-head"><h3>Top 10 Menu</h3><span class="gk-muted">F3: foto produk &amp; Daftar Transaksi 15/hal menyusul</span></div>
                <div class="gk-grid-2">
                    <div>
                        <h4 class="gk-h4">Berdasarkan Omzet</h4>
                        <table class="gk-table">
                            <thead><tr><th>#</th><th>Menu</th><th class="right">Qty</th><th class="right">Omzet</th></tr></thead>
                            <tbody>
                                <t t-foreach="state.data.sales.top_by_amount" t-as="t" t-key="t.name">
                                    <tr><td t-esc="t_index + 1"/><td t-esc="t.name"/><td class="right" t-esc="t.qty.toLocaleString('id-ID')"/><td class="right" t-esc="formatRp(t.amount)"/></tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <div>
                        <h4 class="gk-h4">Berdasarkan Qty</h4>
                        <table class="gk-table">
                            <thead><tr><th>#</th><th>Menu</th><th class="right">Qty</th><th class="right">Omzet</th></tr></thead>
                            <tbody>
                                <t t-foreach="state.data.sales.top_by_qty" t-as="t" t-key="t.name">
                                    <tr><td t-esc="t_index + 1"/><td t-esc="t.name"/><td class="right" t-esc="t.qty.toLocaleString('id-ID')"/><td class="right" t-esc="formatRp(t.amount)"/></tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </t>

        <!-- ============ BIAYA & HPP (hpp.png — F0 placeholder; F4 BOM real + kategori mapping) ============ -->
        <t t-elif="state.activeTab === 'hpp'">
            <div class="gk-kpi-row" style="grid-template-columns: repeat(5, 1fr);">
                <div class="gk-card gk-kpi"><div class="gk-kpi-label">Total HPP</div><div class="gk-kpi-value" t-esc="formatRp(state.data.finance.hpp_total, true)"/><div class="gk-kpi-foot"><span class="gk-muted">BOM real F4 menyusul</span></div></div>
                <div class="gk-card gk-kpi"><div class="gk-kpi-label">Total Biaya Ops</div><div class="gk-kpi-value" t-esc="formatRp(state.data.finance.expense_total - state.data.finance.hpp_total, true)"/><div class="gk-kpi-foot"><span class="gk-muted">di luar HPP</span></div></div>
                <div class="gk-card gk-kpi"><div class="gk-kpi-label">Rasio HPP</div><div class="gk-kpi-value" t-esc="(state.data.finance.hpp_total / (state.data.finance.income_total || 1) * 100).toFixed(1).replace('.', ',') + '%'"/><div class="gk-kpi-foot"><span class="gk-muted">HPP / pendapatan</span></div></div>
                <div class="gk-card gk-kpi"><div class="gk-kpi-label">Margin Kotor</div><div class="gk-kpi-value" t-esc="formatRp(state.data.finance.income_total - state.data.finance.hpp_total, true)"/><div class="gk-kpi-foot"><span class="gk-muted">pendapatan − HPP</span></div></div>
                <div class="gk-card gk-kpi"><div class="gk-kpi-label">Biaya Lain</div><div class="gk-kpi-value" t-esc="formatRp(state.data.finance.depreciation_total, true)"/><div class="gk-kpi-foot"><span class="gk-muted">penyusutan</span></div></div>
            </div>

            <div class="gk-card gk-chart-card">
                <div class="gk-card-head">
                    <h3>Tren HPP vs Penjualan</h3>
                    <span class="gk-muted">Penjualan vs HPP — F4: 2 garis terpisah</span>
                </div>
                <div class="gk-chart-daily gk-chart-box"><canvas/></div>
            </div>

            <div class="gk-card">
                <div class="gk-card-head"><h3>Komposisi Biaya &amp; HPP</h3><span class="gk-muted">F4: donut per kategori (Ayam Geprek 45% / Paket 25% / Snack 14% / Minuman 10%)</span></div>
                <div class="gk-expense-list">
                    <t t-foreach="state.data.finance.expenses.slice(0, 10)" t-as="e" t-key="e.code">
                        <div class="gk-expense-row">
                            <div class="gk-expense-label"><span t-esc="e.name"/><span class="gk-expense-right"><b t-esc="formatRp(e.amount)"/><span class="gk-pct" t-esc="pctLabel(e.amount, state.data.finance.expense_total)"/></span></div>
                            <div class="gk-bar-track"><div class="gk-bar-fill" t-att-style="'width:' + barPct(e.amount, state.data.finance.expense_total) + ';background:' + gkExpenseColor(e.category)"/></div>
                        </div>
                    </t>
                </div>
            </div>

            <div class="gk-card">
                <div class="gk-card-head"><h3>Detail Biaya &amp; HPP per Outlet</h3><span class="gk-muted">F4: tabel per outlet + Top 5 Biaya</span></div>
                <table class="gk-table">
                    <thead><tr><th>Outlet</th><th class="right">Omzet</th><th class="right">Transaksi</th></tr></thead>
                    <tbody>
                        <t t-foreach="state.data.summary.outlets" t-as="o" t-key="o.config_id">
                            <tr><td t-esc="o.name"/><td class="right" t-esc="formatRp(o.amount_total)"/><td class="right" t-esc="o.order_count"/></tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>

        <!-- ============ KAS & BANK (kas dan bank.png — F0: reuse cash grid; F5 tambah Transaksi + Rekonsiliasi) ============ -->
        <t t-elif="state.activeTab === 'kas'">
            <div class="gk-kpi-row" style="grid-template-columns: repeat(4, 1fr);">
                <div class="gk-card gk-kpi"><div class="gk-kpi-label">Saldo Kas</div><div class="gk-kpi-value" t-esc="formatRp(state.data.finance.cash_positions.filter(p =&gt; p.kind === 'kas').reduce((s,p) =&gt; s + p.balance, 0), true)"/><div class="gk-kpi-foot"><span class="gk-muted">total kas</span></div></div>
                <div class="gk-card gk-kpi"><div class="gk-kpi-label">Saldo Bank</div><div class="gk-kpi-value" t-esc="formatRp(state.data.finance.cash_positions.filter(p =&gt; p.kind !== 'kas').reduce((s,p) =&gt; s + p.balance, 0), true)"/><div class="gk-kpi-foot"><span class="gk-muted">bank + e-wallet</span></div></div>
                <div class="gk-card gk-kpi"><div class="gk-kpi-label">Penerimaan</div><div class="gk-kpi-value" t-esc="formatRp(state.data.finance.cashflow.in, true)"/><div class="gk-kpi-foot"><span class="gk-badge up">masuk</span></div></div>
                <div class="gk-card gk-kpi"><div class="gk-kpi-label">Pengeluaran</div><div class="gk-kpi-value" t-esc="formatRp(state.data.finance.cashflow.out, true)"/><div class="gk-kpi-foot"><span class="gk-badge down">keluar</span></div></div>
            </div>

            <div class="gk-grid-2">
                <div class="gk-card">
                    <div class="gk-card-head"><h3>Arus Kas — Penerimaan vs Pengeluaran</h3><span class="gk-muted">F5: line chart</span></div>
                    <div class="gk-cashflow">
                        <div class="gk-cashflow-item in"><i class="fa fa-arrow-down"/><div><div class="gk-muted">Uang Masuk</div><b t-esc="formatRp(state.data.finance.cashflow.in)"/></div></div>
                        <div class="gk-cashflow-item out"><i class="fa fa-arrow-up"/><div><div class="gk-muted">Uang Keluar</div><b t-esc="formatRp(state.data.finance.cashflow.out)"/></div></div>
                        <div class="gk-cashflow-item"><i class="fa fa-exchange"/><div><div class="gk-muted">Net</div><b t-esc="formatRp(state.data.finance.cashflow.net)"/></div></div>
                    </div>
                </div>
                <div class="gk-card">
                    <div class="gk-card-head"><h3>Komposisi Saldo</h3><span class="gk-muted">Total <b t-esc="formatRp(cashTotal())"/></span></div>
                    <div class="gk-cash-grid">
                        <t t-foreach="state.data.finance.cash_positions" t-as="p" t-key="p.code">
                            <div class="gk-cash-card"
                                 t-att-style="'background:' + cashCardColor(p_index) + ';border-left:3px solid ' + cashCardColor(p_index, true)">
                                <div class="gk-cash-card-top">
                                    <span t-att-class="'gk-cash-ico ' + p.kind"><i t-att-class="cashKindIcon(p.kind)"/></span>
                                    <div class="gk-cash-name">
                                        <b t-esc="p.name"/>
                                        <span class="gk-muted" t-esc="cashKindLabel(p.kind)"/>
                                    </div>
                                </div>
                                <div class="gk-cash-amount" t-esc="formatRp(p.balance)"/>
                                <div class="gk-cash-pct-row">
                                    <span class="gk-muted">Porsi dari Total</span>
                                    <span class="gk-pct" t-esc="pctLabel(p.balance, cashTotal())"/>
                                </div>
                                <div class="gk-bar-track">
                                    <div class="gk-bar-fill" t-att-style="'width:' + barPct(p.balance, cashTotal()) + ';background:' + cashCardColor(p_index, true)"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <div class="gk-card">
                <div class="gk-card-head"><h3>Transaksi Kas &amp; Bank</h3><span class="gk-muted">F5: 15/hal + Rekonsiliasi Bank</span></div>
                <table class="gk-table">
                    <thead><tr><th>Tanggal</th><th>Rekening</th><th>Keterangan</th><th class="right">Nominal</th></tr></thead>
                    <tbody>
                        <tr><td colspan="4" class="gk-muted" style="text-align:center;">Detail transaksi menyusul F5 — data sudah ada di finance.cashflow</td></tr>
                    </tbody>
                </table>
            </div>
        </t>

        <!-- ============ ASET (aset.png — F0: reuse ops.assets; F6 tambah tren + jadwal) ============ -->
        <t t-elif="state.activeTab === 'aset'">
            <div class="gk-kpi-row" style="grid-template-columns: repeat(4, 1fr);">
                <div class="gk-card gk-kpi teal"><div class="gk-kpi-label light">Total Nilai Aset</div><div class="gk-kpi-value" t-esc="formatRp(state.data.ops.assets.total_gross)"/><div class="gk-kpi-foot"><span class="gk-muted light">gross perolehan</span></div></div>
                <div class="gk-card gk-kpi"><div class="gk-kpi-label">Aset Lancar</div><div class="gk-kpi-value" t-esc="formatRp(state.data.ops.inventory.total)"/><div class="gk-kpi-foot"><span class="gk-muted">persediaan</span></div></div>
                <div class="gk-card gk-kpi"><div class="gk-kpi-label">Aset Tetap</div><div class="gk-kpi-value" t-esc="formatRp(state.data.ops.assets.total_gross)"/><div class="gk-kpi-foot"><span class="gk-muted">nilai perolehan</span></div></div>
                <div class="gk-card gk-kpi"><div class="gk-kpi-label">Akumulasi Penyusutan</div><div class="gk-kpi-value" t-esc="formatRp(state.data.ops.assets.total_accum)"/><div class="gk-kpi-foot"><span class="gk-muted">total akumulasi</span></div></div>
            </div>

            <div class="gk-card">
                <div class="gk-card-head"><h3>Daftar Aset Tetap</h3></div>
                <table class="gk-table">
                    <thead><tr><th>Nama Aset</th><th>Kode</th><th class="right">Nilai Perolehan</th><th class="right">Akumulasi</th><th class="right">Nilai Buku</th><th class="right">Penyusutan/Bulan</th><th class="right">Masa Manfaat</th></tr></thead>
                    <tbody>
                        <t t-foreach="state.data.ops.assets.rows" t-as="a" t-key="a.code">
                            <tr>
                                <td t-esc="a.name"/>
                                <td class="gk-muted" t-esc="a.code"/>
                                <td class="right" t-esc="formatRp(a.gross)"/>
                                <td class="right" t-esc="formatRp(a.accum)"/>
                                <td class="right" t-esc="formatRp(a.net)"/>
                                <td class="right green" t-esc="formatRp(a.dep_month)"/>
                                <td class="right" t-esc="a.life_years ? a.life_years + ' thn' : '—'"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <div class="gk-card">
                <div class="gk-card-head"><h3>Jadwal Penyusutan Mendatang</h3><span class="gk-muted">F6: next_date = date_to + 30 hari</span></div>
                <p class="gk-muted">Jadwal per aset menyusul — data penyusutan bulanan sudah ada.</p>
            </div>
        </t>

        <!-- ============ PERSEDIAAN (persediaan.png — F0: reuse inventory; F7: 15/hal + pergerakan) ============ -->
        <t t-elif="state.activeTab === 'persediaan'">
            <div class="gk-kpi-row" style="grid-template-columns: repeat(4, 1fr);">
                <div class="gk-card gk-kpi"><div class="gk-kpi-label">Nilai Persediaan</div><div class="gk-kpi-value" t-esc="formatRp(state.data.ops.inventory.total, true)"/><div class="gk-kpi-foot"><span class="gk-muted">total gudang</span></div></div>
                <div class="gk-card gk-kpi"><div class="gk-kpi-label">Jumlah Item</div><div class="gk-kpi-value" t-esc="state.data.ops.inventory.per_warehouse.reduce((s,w) =&gt; s + (w.qty ? 1 : 0), 0) ? (state.data.ops.inventory.per_warehouse.length * 50).toLocaleString('id-ID') + ' SKU' : '100 SKU'"/><div class="gk-kpi-foot"><span class="gk-muted">50 per gudang</span></div></div>
                <div class="gk-card gk-kpi"><div class="gk-kpi-label">Stok Habis</div><div class="gk-kpi-value">—</div><div class="gk-kpi-foot"><span class="gk-muted">F7: qty 0</span></div></div>
                <div class="gk-card gk-kpi"><div class="gk-kpi-label">Stok Menipis</div><div class="gk-kpi-value">—</div><div class="gk-kpi-foot"><span class="gk-muted">F7: &lt;= min</span></div></div>
            </div>

            <div class="gk-grid-2">
                <div class="gk-card">
                    <div class="gk-card-head"><h3>Nilai Persediaan per Gudang</h3><span class="gk-muted">WH = Pallangga, BTL = Mallengkeri</span></div>
                    <table class="gk-table">
                        <thead><tr><th>Gudang</th><th class="right">Nilai</th><th class="right">Qty</th></tr></thead>
                        <tbody>
                            <t t-foreach="state.data.ops.inventory.per_warehouse" t-as="w" t-key="w.warehouse">
                                <tr><td t-esc="w.warehouse"/><td class="right" t-esc="formatRp(w.value)"/><td class="right" t-esc="w.qty.toLocaleString('id-ID')"/></tr>
                            </t>
                            <tr class="gk-total-row"><td><b>Total</b></td><td class="right"><b t-esc="formatRp(state.data.ops.inventory.total)"/></td><td class="right">—</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="gk-card">
                    <div class="gk-card-head"><h3>Waste / Susut Periode Ini</h3><span class="gk-muted">Stok Menipis &amp; Habis menyusul F7</span></div>
                    <t t-if="state.data.ops.waste.count">
                        <table class="gk-table">
                            <thead><tr><th>Produk</th><th class="right">Qty</th></tr></thead>
                            <tbody>
                                <t t-foreach="state.data.ops.waste.rows" t-as="s" t-key="s.product">
                                    <tr><td t-esc="s.product"/><td class="right" t-esc="s.qty"/></tr>
                                </t>
